{
  "name": "@ideaspaces/editor",
  "version": "0.1.0",
  "description": "Shared IdeaSpaces note editor — Obsidian-style live-preview Markdown over CodeMirror 6 + @atomic-editor/editor. Consumed by is_web and is_desktop.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frontmatter": {
      "types": "./dist/frontmatter.d.ts",
      "import": "./dist/frontmatter.js"
    },
    "./styles.css": "./dist/editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/editor.css dist/editor.css",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@fontsource/sorts-mill-goudy": "^5.2.8"
  },
  "peerDependencies": {
    "@atomic-editor/editor": "0.4.3",
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@atomic-editor/editor": "0.4.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
